#!/usr/bin/bash
set -u

# O tmux virou painel de observabilidade: quem supervisiona worker e servidor
# sao as unidades split-llama-worker.service e split-llama-server.service,
# com Restart=on-failure. Este painel so segue os logs; a troca de papel e
# feita por `split-llama mode`, que cuida de lock, readiness e rollback.

printf 'Papeis: split-llama mode worker|distributed-master|replica|idle|status\n'
printf 'Master:  split-llama mode distributed-master --model large --parallel 8 --rpc ip1:50052,ip2:50052\n'
printf 'Replica: split-llama mode replica --model small --parallel 4\n\n'

journalctl -fu split-llama-worker.service -fu split-llama-server.service
status=$?

# Fechar o painel tiraria da tela o log que explica por que uma unidade
# morreu, que e a unica pista no console fisico.
printf '\njournalctl encerrado com status %d.\n' "$status"
exec /usr/bin/bash
