#!/usr/bin/bash
set -euo pipefail

# Mesmo layout da imagem estavel -- worker a esquerda, btop a direita -- para
# que o operador nao precise reaprender a tela. O aviso de RPC inseguro fica na
# barra: a variante expoe execucao remota de codigo sem autenticacao, e isso
# tem que estar visivel, nao so na documentacao.

session="split-models"
/usr/bin/tmux new-session -d -s "$session" -n node \
    /usr/local/bin/split-llama-session
/usr/bin/tmux split-window -h -p 35 -t "$session:node" \
    /usr/local/bin/split-models-monitor
/usr/bin/tmux set-option -t "$session" status-interval 2
/usr/bin/tmux set-option -t "$session" status-left ' EXPERIMENTAL RPC - LAN ISOLADA '
/usr/bin/tmux set-option -t "$session" status-left-length 40
/usr/bin/tmux set-option -t "$session" status-right-length 120
/usr/bin/tmux set-option -t "$session" status-right \
    '#(/usr/local/bin/split-models-status) '
