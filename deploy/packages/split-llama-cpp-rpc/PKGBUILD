# Maintainer: vitor <thegreath76@gmail.com>
#
# llama.cpp com backend RPC e Vulkan, para a variante experimental da appliance.
# O pacote do Arch (extra/llama-cpp) nao serve: precisamos de GGML_RPC e
# GGML_VULKAN ligados e de um commit fixado, para que master e workers rodem
# exatamente o mesmo binario.
#
# O pin vive em llama-version.env, arquivo unico lido tambem pelos testes.

source ./llama-version.env

pkgname=split-llama-cpp-rpc
pkgver="${LLAMA_TAG}"
pkgrel=1
pkgdesc="llama.cpp ${LLAMA_TAG} with RPC and Vulkan backends, pinned for the split-models appliance"
arch=('x86_64')
url='https://github.com/ggml-org/llama.cpp'
license=('MIT')
depends=('gcc-libs' 'glibc' 'vulkan-icd-loader')
makedepends=('cmake' 'vulkan-headers' 'shaderc')
provides=('llama-cpp')
conflicts=('llama-cpp')
options=(!lto)
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/${LLAMA_TAG}.tar.gz")
sha256sums=("${LLAMA_SHA256}")

_srcdir="llama.cpp-${LLAMA_TAG}"

# GGML_BACKEND_DL carrega os backends como plugin, entao uma imagem so serve
# host com Vulkan e host sem: o CPU vira fallback em vez de erro de link.
# GGML_CPU_ALL_VARIANTS exige GGML_NATIVE=OFF e embute variantes de ISA
# escolhidas em runtime -- obrigatorio numa ISO que roda em maquinas diferentes
# daquela onde foi compilada.
# LLAMA_TOOLS_INSTALL nao esta no default de todos os fluxos e e o que instala
# ggml-rpc-server (tools/rpc/CMakeLists.txt), o binario central desta variante.
_cmake_options=(
    -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_INSTALL_PREFIX=/usr
    -DBUILD_SHARED_LIBS=ON
    -DGGML_BACKEND_DL=ON
    -DGGML_CPU=ON
    -DGGML_CPU_ALL_VARIANTS=ON
    -DGGML_NATIVE=OFF
    -DGGML_VULKAN=ON
    -DGGML_RPC=ON
    -DLLAMA_BUILD_TESTS=OFF
    -DLLAMA_BUILD_EXAMPLES=OFF
    -DLLAMA_BUILD_TOOLS=ON
    -DLLAMA_BUILD_SERVER=ON
    -DLLAMA_TOOLS_INSTALL=ON
)

build() {
    cd "${_srcdir}"
    cmake -B build -S . "${_cmake_options[@]}"
    cmake --build build --config Release
}

check() {
    cd "${_srcdir}"
    ./build/bin/ggml-rpc-server --help >/dev/null
    ./build/bin/llama-cli --version >/dev/null
}

package() {
    cd "${_srcdir}"
    DESTDIR="${pkgdir}" cmake --install build
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    _write_build_info
}

# Sem isso nao da para saber, num host ja instalado, qual commit gerou o binario
# -- e incompatibilidade de RPC entre hosts aparece so em runtime.
_write_build_info() {
    local info="${pkgdir}/usr/share/doc/${pkgname}/build-info.txt"
    install -d "$(dirname -- "${info}")"
    {
        printf 'upstream: %s\n' "${url}"
        printf 'tag: %s\n' "${LLAMA_TAG}"
        printf 'commit: %s\n' "${LLAMA_COMMIT}"
        printf 'source-sha256: %s\n' "${LLAMA_SHA256}"
        printf 'cmake:\n'
        printf '  %s\n' "${_cmake_options[@]}"
    } > "${info}"
}
