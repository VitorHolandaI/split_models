#!/usr/bin/bash
set -u

set -a
source /etc/split-models.env
set +a
install -d -m 0755 "$HF_HOME" "$TMPDIR" /run/split-models/benchmark-results
uuid="$(< /proc/sys/kernel/random/uuid)"
node_id="${SPLIT_NODE_ID:-node-${uuid%%-*}}"
printf '%s\n' "$node_id" > /run/split-models/node-id
printf 'worker\n' > /run/split-models/role
cd /opt/split-models || exit 1
split-cluster worker --node-id "$node_id"
status=$?
printf 'shell\n' > /run/split-models/role
printf '\nWorker encerrado com status %d.\n' "$status"
printf 'Master: /root/split-master.sh\n'
printf 'Comandos: cat /root/README-split-models.txt\n'
exec /usr/bin/bash
