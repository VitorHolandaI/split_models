[Unit]
Description=Split Models cluster worker session
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/tmux new-session -d -s split-models /usr/local/bin/split-models-session
ExecStop=-/usr/bin/tmux kill-session -t split-models

[Install]
WantedBy=multi-user.target
